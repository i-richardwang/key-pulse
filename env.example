# =============================================================================
# KeyPulse Environment Configuration
# =============================================================================
# Copy this file to .env.local and modify as needed
# Required variables are marked with [REQUIRED]

# =============================================================================
# Database Configuration [REQUIRED]
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/keypulse

# =============================================================================
# Security Configuration [REQUIRED]
# =============================================================================
# Encryption secret for API keys stored in database
# IMPORTANT: Use a strong random string with at least 32 characters
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your-strong-random-secret-at-least-32-chars

# Authentication password for UI access
# Leave empty to disable authentication (not recommended for production)
AUTH_PASSWORD=

# =============================================================================
# Bifrost Integration (Optional)
# =============================================================================
# Configure these settings if you want to sync with Bifrost API gateway
# You can use either API URL or direct database connection

# Bifrost API endpoint (for API-based sync)
# BIFROST_API_URL=http://localhost:8080

# Bifrost API credentials (if required)
# BIFROST_USERNAME=admin
# BIFROST_PASSWORD=password

# Bifrost database connection (for direct database sync)
# This is faster but requires direct database access
# BIFROST_DATABASE_URL=postgresql://postgres:password@localhost:5432/bifrost

# =============================================================================
# Optional Settings
# =============================================================================
# Node environment (development, production, test)
# NODE_ENV=development

# Server port (default: 3000)
# PORT=3000
